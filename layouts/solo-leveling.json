{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#02071299",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-timer"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "sl-pane"
                    },
                    "reveal": "always",
                    "height": 36,
                    "position": "top"
                  },
                  "background": "#030a1a99",
                  "shadow": "lg",
                  "border": {
                    "width": 1,
                    "color": "#4fb8ffaa"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#7fe6ff"
                  },
                  "radius": 14,
                  "gap": 12,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 12,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/system-notice.jpg",
    "fit": "cover"
  },
  "theme": "solo-leveling",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.7,
  "divider": {
    "width": 1,
    "color": "#1d4f8f"
  },
  "floating": [
    {
      "id": "sl-engine",
      "content": {
        "mod": "sl-system",
        "props": {
          "view": "engine"
        }
      },
      "edge": "bottom",
      "align": "start"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "sl-toast"
}